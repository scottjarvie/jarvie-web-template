# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# PostgreSQL connection string for Drizzle ORM
DATABASE_URL=postgres://postgres:postgres@localhost:5432/your_database

# ----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------------------------------------
# URL to your Supabase instance (create at https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
# Public anon key from Supabase project settings
SUPABASE_ANON_KEY=your-anon-key
# Service role key for admin operations (keep secure)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket name for file uploads
SUPABASE_STORAGE_BUCKET=uploads

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------
# Port for the Hono API server
PORT=3004
# Set to true in production
API_PRODUCTION=false

# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ----------------------------------------------------------------------------
# URL for API connection from the frontend
NEXT_PUBLIC_API_URL=http://localhost:3004
# Mirror of Supabase config for frontend access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Enable/disable analytics (true/false)
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ----------------------------------------------------------------------------
# CLERK AUTHENTICATION
# ----------------------------------------------------------------------------
# Secret key from Clerk dashboard (https://clerk.com)
CLERK_SECRET_KEY=your-clerk-secret
# Publishable key for frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
# Webhook signing secret for verifying webhook requests
CLERK_SIGNING_SECRET=your-clerk-webhook-secret

# ----------------------------------------------------------------------------
# OPENAI CONFIGURATION
# ----------------------------------------------------------------------------
# API key from OpenAI dashboard (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key
# Default model to use (e.g., gpt-4o, gpt-4, gpt-3.5-turbo)
OPENAI_DEFAULT_MODEL=gpt-4o

# ----------------------------------------------------------------------------
# BACKBLAZE B2 CONFIGURATION (S3-COMPATIBLE STORAGE)
# ----------------------------------------------------------------------------
# Key ID from Backblaze B2 application keys
B2_KEY_ID=your-backblaze-key-id
# Application key (keep secure)
B2_KEY_SECRET=your-backblaze-application-key
# Name of your B2 bucket
B2_BUCKET_NAME=your-bucket-name
# Region of your bucket (check Backblaze dashboard)
B2_REGION=us-west-002
# S3-compatible endpoint URL
B2_ENDPOINT=s3.us-west-002.backblazeb2.com